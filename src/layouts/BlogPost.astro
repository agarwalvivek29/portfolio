---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { frontmatter, headings } = Astro.props;
const { title, subtitle, description, author, date } = frontmatter;
// count prose only: code and diagram blocks would inflate the estimate
const words = (Astro.props.rawContent?.() ?? '').replace(/```[\s\S]*?```/g, '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));
const published = new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${title} — Vivek Agarwal`} description={description}>
  <Navbar />
  <div id="read-progress" class="fixed top-16 left-0 h-0.5 bg-accent z-50 w-0"></div>
  <article class="pt-28 pb-16 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto">
    <a href="/" class="inline-flex items-center gap-1 text-sm text-text-muted hover:text-text transition-colors mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Home
    </a>

    <header class="mb-12 border-b border-border pb-8">
      <h1 class="text-3xl sm:text-5xl font-bold leading-tight mb-4">{title}</h1>
      {subtitle && <p class="text-lg sm:text-xl text-text-muted mb-6">{subtitle}</p>}
      <p class="text-sm text-text-dim">{author} · {published} · {minutes} min read</p>
    </header>

    <div class="post">
      <slot />
    </div>
  </article>
  <Footer />
</Layout>

<script>
  import mermaid from 'mermaid';

  // Mermaid: Astro leaves excluded langs as <pre class="mermaid"> or <pre><code class="language-mermaid">
  const blocks = document.querySelectorAll<HTMLElement>('.post pre.mermaid, .post pre:has(> code.language-mermaid)');
  blocks.forEach((pre) => {
    const div = document.createElement('div');
    div.className = 'mermaid';
    div.textContent = pre.textContent ?? '';
    pre.replaceWith(div);
  });
  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    themeVariables: { background: '#111111', primaryColor: '#1a1a1a', primaryTextColor: '#e5e5e5', lineColor: '#737373', fontFamily: 'Inter, sans-serif' },
  });
  mermaid.run({ querySelector: '.post .mermaid' });

  // Checklists: make them tickable and show a running score
  document.querySelectorAll<HTMLUListElement>('.post ul.contains-task-list').forEach((list) => {
    const boxes = Array.from(list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const score = document.createElement('p');
    score.className = 'task-score';
    const update = () => {
      const n = boxes.filter((b) => b.checked).length;
      score.textContent = `${n} / ${boxes.length} ticked`;
    };
    boxes.forEach((b) => {
      b.disabled = false;
      b.addEventListener('change', update);
    });
    update();
    list.after(score);
  });

  // Reading progress bar
  const bar = document.getElementById('read-progress');
  const onScroll = () => {
    const h = document.documentElement;
    const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
    if (bar) bar.style.width = `${pct}%`;
  };
  document.addEventListener('scroll', onScroll, { passive: true });
</script>

<style is:global>
  .post { color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.8; }
  .post > * + * { margin-top: 1.25rem; }
  .post h2 { color: var(--color-text); font-size: 1.75rem; font-weight: 700; line-height: 1.3; margin-top: 3rem; scroll-margin-top: 5rem; }
  .post h3 { color: var(--color-text); font-size: 1.3rem; font-weight: 600; margin-top: 2.25rem; scroll-margin-top: 5rem; }
  .post strong { color: var(--color-text); font-weight: 600; }
  .post a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .post hr { border: 0; border-top: 1px solid var(--color-border-hover); margin: 3rem 0; }
  .post ul { list-style: disc; padding-left: 1.5rem; }
  .post ol { list-style: decimal; padding-left: 1.5rem; }
  .post li + li { margin-top: 0.4rem; }
  .post ul.contains-task-list { list-style: none; padding-left: 0; }
  .post .task-list-item { position: relative; padding: 0.5rem 0.75rem 0.5rem 2.25rem; border: 1px solid var(--color-border-hover); border-radius: 0.5rem; background: var(--color-bg-card); }
  .post .task-list-item input { position: absolute; left: 0.75rem; top: 0.95rem; accent-color: var(--color-accent); width: 1rem; height: 1rem; cursor: pointer; }
  .post .task-score { font-size: 0.9rem; color: var(--color-accent); font-weight: 600; margin-top: 0.75rem; }
  .post blockquote { border-left: 3px solid var(--color-accent); padding: 0.25rem 0 0.25rem 1.25rem; color: var(--color-text); }
  .post blockquote p + p { margin-top: 0.75rem; }
  .post code { font-size: 0.875em; background: var(--color-bg-card-hover); padding: 0.15rem 0.35rem; border-radius: 0.3rem; color: var(--color-text); }
  .post pre { padding: 1rem 1.25rem; border-radius: 0.6rem; border: 1px solid var(--color-border-hover); overflow-x: auto; font-size: 0.875rem; line-height: 1.6; }
  .post pre code { background: none; padding: 0; }
  .post table { width: 100%; border-collapse: collapse; font-size: 0.925rem; display: block; overflow-x: auto; }
  .post th, .post td { border: 1px solid var(--color-border-hover); padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
  .post th { color: var(--color-text); background: var(--color-bg-card); }
  .post details { border: 1px solid var(--color-border-hover); border-radius: 0.6rem; background: var(--color-bg-card); padding: 0.75rem 1rem; }
  .post details > * + * { margin-top: 1rem; }
  .post summary { cursor: pointer; color: var(--color-text); }
  .post .mermaid { display: flex; justify-content: center; padding: 1.25rem; border: 1px solid var(--color-border-hover); border-radius: 0.6rem; background: var(--color-bg-card); overflow-x: auto; }
</style>
